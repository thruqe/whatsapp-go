{
  // VS Code debug configurations for WhatsRook (whatsrook/cmd).
  // All configurations target the `cmd/` entrypoint (module: whatsrook/cmd).
  // GOEXPERIMENT=nojsonv2 mirrors the canonical `task build` environment.
  // Session / database values are pulled from the root `.env` file — edit
  // that file to change credentials without touching this config.
  "version": "0.2.0",
  "configurations": [
    {
      // ── Primary: run the bot with values from .env ──────────────────────
      "name": "WhatsRook: Run Bot",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd",
      "cwd": "${workspaceFolder}/cmd",
      "env": {
        "GOEXPERIMENT": "nojsonv2",
        "SESSION": "${env:SESSION}",
        "DATABASE_URL": "${env:DATABASE_URL}",
        "VERBOSE": "true"
      },
      "envFile": "${workspaceFolder}/.env",
      "args": [],
      "showLog": true,
      "trace": "verbose"
    },
    {
      // ── Standby: no session provided; falls back to interactive stdin prompt
      "name": "WhatsRook: Standby",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd",
      "cwd": "${workspaceFolder}/cmd",
      "env": {
        "GOEXPERIMENT": "nojsonv2",
        "DATABASE_URL": "${env:DATABASE_URL}",
        "VERBOSE": "true"
      },
      "envFile": "${workspaceFolder}/.env",
      "args": [],
      "showLog": true,
      "trace": "verbose"
    },
    {
      // ── QR auth: authenticate a new session via QR code ─────────────────
      "name": "WhatsRook: QR Auth",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd",
      "cwd": "${workspaceFolder}/cmd",
      "env": {
        "GOEXPERIMENT": "nojsonv2",
        "DATABASE_URL": "${env:DATABASE_URL}",
        "VERBOSE": "true"
      },
      "envFile": "${workspaceFolder}/.env",
      "args": ["${env:SESSION}", "-auth", "qr"],
      "showLog": true,
      "trace": "verbose"
    },
    {
      // ── Pair auth: authenticate a new session via phone number pairing ──
      "name": "WhatsRook: Pair Auth",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd",
      "cwd": "${workspaceFolder}/cmd",
      "env": {
        "GOEXPERIMENT": "nojsonv2",
        "DATABASE_URL": "${env:DATABASE_URL}",
        "VERBOSE": "true"
      },
      "envFile": "${workspaceFolder}/.env",
      "args": ["${env:SESSION}", "-auth", "pair"],
      "showLog": true,
      "trace": "verbose"
    },
    {
      // ── Update check: verify whether a new release is available ─────────
      "name": "WhatsRook: Update Check",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd",
      "cwd": "${workspaceFolder}/cmd",
      "env": {
        "GOEXPERIMENT": "nojsonv2"
      },
      "envFile": "${workspaceFolder}/.env",
      "args": ["update", "check"],
      "showLog": true
    },
    {
      // ── Tests: run the full cmd test suite with race detector ────────────
      "name": "WhatsRook: Run Tests (cmd)",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}/cmd",
      "cwd": "${workspaceFolder}/cmd",
      "env": {
        "GOEXPERIMENT": "nojsonv2"
      },
      "envFile": "${workspaceFolder}/.env",
      "args": ["-v", "-race", "-timeout", "120s", "./..."],
      "showLog": true
    }
  ]
}
