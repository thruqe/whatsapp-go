# ==============================================================================
# WhatsRook Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust variables as needed for your deployment:
#   cp .env.example .env
#
# Note: Plain-word CLI arguments override values defined in this file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary Session & Authentication
# ------------------------------------------------------------------------------
# WhatsApp phone number (with country code, digits only or leading plus).
# If left unset, WhatsRook launches in interactive/headless standby mode.
# Example: 2348000000000
SESSION=

# Authentication mode:
#   - qr   : Display ASCII QR code in terminal for scanning (default)
#   - pair : Request 8-character pairing code for linking with phone number
AUTH=qr

# Companion client platform signature:
#   - default : Chrome browser emulation (recommended)
#   - android : Android client emulation
#   - ios     : iOS client emulation
CLIENT=default

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL Only)
# ------------------------------------------------------------------------------
# Primary PostgreSQL connection URL.
# WhatsRook strictly uses PostgreSQL for persistent session storage and custom data.
# SQLite is not supported.
#
# Formats:
#   - Local:    postgres://postgres:postgres@localhost:5432/whatsrook?sslmode=disable
#   - Supabase: postgresql://postgres.[ref]:[pass]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
#   - Neon:     postgresql://[user]:[pass]@[host]/[dbname]?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/whatsrook?sslmode=disable

# Per-session database overrides (optional):
# Isolate a specific phone number session to a dedicated database instance.
# Format: DATABASE_URL_<PHONE> (without leading plus)
# DATABASE_URL_2348000000000=postgres://user:pass@db2.example.com:5432/session1?sslmode=disable

# ------------------------------------------------------------------------------
# 3. Auto-Update
# ------------------------------------------------------------------------------
# Automatically check for updates from the release channel on launch.
# If an update is detected, WhatsRook downloads, verifies, and atomically swaps
# the binary, then automatically restarts itself.
# Options: on, off (default: off)
AUTOUPDATE=off

# ------------------------------------------------------------------------------
# 4. Permissions & Sudo Users
# ------------------------------------------------------------------------------
# Space-separated list of phone numbers, WhatsApp JIDs, or LIDs granted
# elevated/sudo permissions to administer bot commands.
# Example: "2348000000000 123456789012345@lid"
SUDOERS=

# ------------------------------------------------------------------------------
# 5. Logging & Diagnostics
# ------------------------------------------------------------------------------
# Logging verbosity level: debug, info, warn, error
# Alternatively, set VERBOSE=true or DEBUG=true for detailed protocol tracing.
LOG_LEVEL=info
VERBOSE=false

# Disable terminal ANSI colors (useful for cloud log ingestion systems)
# NO_COLOR=1

# ------------------------------------------------------------------------------
# 6. Paths & Directories (Optional)
# ------------------------------------------------------------------------------
# Custom base directory for persistent state and downloads (default: current directory)
# WHATSROOK_DATA_DIR=

# Custom directory for external plugins (default: current directory or system path)
# PLUGIN_DIR=
